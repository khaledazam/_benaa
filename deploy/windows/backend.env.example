# Store the real file OUTSIDE the release folder. Never commit or deliver values.
NODE_ENV=production
PORT=3217
BENAA_DEPLOYMENT_ENV=staging
BENAA_DATABASE_HOST=SET_APPROVED_ATLAS_HOST
BENAA_DATABASE_NAME=SET_APPROVED_DATABASE_NAME
DATABASE_URL=SET_SERVER_SIDE_MONGODB_SRV_URI
JWT_SECRET=SET_OPERATOR_GENERATED_RANDOM_SECRET
NEXT_PUBLIC_API_URL=https://SET_APPROVED_API_HOSTNAME
NEXT_PUBLIC_APP_URL=https://SET_APPROVED_API_HOSTNAME
BENAA_ALLOWED_ORIGINS=https://SET_APPROVED_API_HOSTNAME
BENAA_WRITE_DISABLED=true
BENAA_STAGING_WRITES_APPROVED=false
BENAA_CUSTOMER_WRITES_APPROVED=false
BENAA_WRITE_DISABLE_FILE=C:\ProgramData\BENAA\WRITE_DISABLED
BENAA_SHUTDOWN_TOKEN=SET_OPERATOR_GENERATED_RANDOM_LOCAL_CONTROL_SECRET
# Uses the same authorized Atlas database; no separate Redis hosting required.
# Verify the RateLimitBucket expiresAt TTL index during DB initialization.
BENAA_RATE_LIMIT_BACKEND=mongodb
