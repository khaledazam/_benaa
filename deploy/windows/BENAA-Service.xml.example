<service>
  <id>BENAA-Backend</id>
  <name>BENAA Backend</name>
  <description>Single-company authoritative BENAA ERP API; loopback only.</description>
  <executable>%BASE%\node.exe</executable>
  <arguments>"%BASE%\start-backend.cjs"</arguments>
  <stopexecutable>%BASE%\node.exe</stopexecutable>
  <stoparguments>"%BASE%\stop-backend.cjs"</stoparguments>
  <env name="BENAA_WINDOWS_CONFIG" value="C:\ProgramData\BENAA\backend.env" />
  <workingdirectory>%BASE%</workingdirectory>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="15 sec" />
  <onfailure action="restart" delay="60 sec" />
  <stoptimeout>60 sec</stoptimeout>
  <log mode="roll-by-size"><sizeThreshold>10240</sizeThreshold><keepFiles>8</keepFiles></log>
</service>
